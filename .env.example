# Application Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Security Key - Replace with a cryptographically secure random string in production
SECRET_KEY=dev-secret-key-campusskill-ai-change-in-production-2026

# Database Configuration
# SQLite for local development:
DATABASE_URL=sqlite:///campusskill.db
# PostgreSQL example for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/campusskill_db

# File Upload Settings
MAX_CONTENT_LENGTH=5242880 # 5 MB max upload
UPLOAD_FOLDER=uploads
